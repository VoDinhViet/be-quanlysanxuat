PORT=8003
DATABASE_URL=postgresql://user:password@localhost:5432/db
DATABASE_SSL_MODE=false
FRONTEND_DOMAIN=http://localhost:3000
BACKEND_DOMAIN=http://localhost:8003
AUTH_CONFIRM_EMAIL_EXPIRES=24h
AUTH_JWT_SECRET=secret
AUTH_JWT_TOKEN_EXPIRES_IN=15m
AUTH_REFRESH_SECRET=refresh_secret
AUTH_REFRESH_TOKEN_EXPIRES_IN=7d
REDIS_URL=redis://localhost:6379
UPLOAD_DRIVER=local
UPLOAD_DIR=uploads
UPLOAD_MAX_IMAGE_SIZE=5242880
UPLOAD_MAX_DOCUMENT_SIZE=10485760
# Grace period before an uploaded-but-never-linked file is swept, in seconds. Must be longer than
# the longest realistic form-filling session.
UPLOAD_ORPHAN_TTL=86400
# Thời gian giữ file nằm trong bản nháp form kể từ lần "Lưu nháp" cuối, tính bằng giây (30 ngày).
# Phải khớp FORM_DRAFT_TTL_DAYS của web.
UPLOAD_DRAFT_TTL=2592000

# MCP server (/api/mcp, đọc-chỉ cho agent chat nội bộ). Bỏ trống = tắt.
# Access key duy nhất do admin quản lý, tối thiểu 32 ký tự, ví dụ: openssl rand -hex 32
# Client chỉ gửi header Api-Key; key hợp lệ đọc được mọi dữ liệu (chưa phân quyền theo người dùng).
# Đổi giá trị rồi khởi động lại để xoay khoá.
MCP_API_KEY=
MCP_RATE_LIMIT_PER_MINUTE=120
