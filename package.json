  "scripts": {
    "build": "nest build",
    "format": "prettier --write \"src/**/*.ts\" \"test/**/*.ts\"",
    "start": "nest start",
    "start:dev": "nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/src/main",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:watch": "jest --watch",
    "test:cov": "jest --coverage",
    "test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "db:generate": "drizzle-kit generate",
    "db:seed:departments-roles-positions": "ts-node src/database/seeds/departments-roles-positions.seed.ts",
    "db:seed:credentials": "ts-node src/database/seeds/credentials.seed.ts",
    "db:seed:client-groups": "ts-node src/database/seeds/client-groups.seed.ts",
    "db:seed:clients": "ts-node src/database/seeds/clients.seed.ts",
    "db:seed:countries": "ts-node src/database/seeds/countries.seed.ts",
    "db:seed:units": "ts-node src/database/seeds/units.seed.ts",
    "db:seed:supplier-groups": "ts-node src/database/seeds/supplier-groups.seed.ts",
    "db:seed:suppliers": "ts-node src/database/seeds/suppliers.seed.ts",
    "db:seed:items": "ts-node src/database/seeds/items.seed.ts",
    "db:seed:operations": "ts-node src/database/seeds/operations.seed.ts",
    "db:seed:supplier-returns": "ts-node src/database/seeds/supplier-returns.seed.ts",
    "db:seed:iqc": "ts-node src/database/seeds/iqc.seed.ts",
    "db:seed:material-stock": "ts-node src/database/seeds/material-stock.seed.ts",
    "db:seed:qc-aql": "ts-node src/database/seeds/qc-aql.seed.ts",
    "db:seed:document-sequences-bootstrap": "ts-node src/database/seeds/document-sequences-bootstrap.seed.ts",
    "db:migrate": "drizzle-kit migrate",
    "db:check-drift": "ts-node src/database/check-migration-drift.ts",
    "db:reset": "ts-node src/database/reset-data.ts",
    "db:reset:transactions": "ts-node src/database/reset-transactions.ts",
    "db:studio": "drizzle-kit studio"
