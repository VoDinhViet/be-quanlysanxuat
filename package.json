    "@nestjs/testing": "^11.1.19",
    "@types/bcryptjs": "^3.0.0",
    "@types/cache-manager": "^5.0.0",
    "@types/express": "^5.0.6",
    "@types/jest": "^30.0.0",
    "@types/lodash": "^4.17.24",
    "@types/ms": "^2.1.0",
    "@types/multer": "^2.1.0",
    "@types/node": "^24.12.4",
    "@types/supertest": "^7.2.0",
    "@types/uuid": "^11.0.0",
    "drizzle-kit": "^0.31.10",
