# Biến cho docker-compose.yml. Đặt trong file `.env` cạnh docker-compose.yml (trên VPS: /opt/quanlysanxuat/.env).
# Khác với .env.production (biến của app bên trong container). `remote-deploy.sh` chỉ ghi thêm APP_IMAGE.

# Bắt buộc. Dùng chuỗi hex để khỏi phải mã hoá URL: openssl rand -hex 24
POSTGRES_PASSWORD=
# POSTGRES_USER=qlsx
# POSTGRES_DB=qlsx
# Cổng Postgres trên loopback của host (chỉ 127.0.0.1, dùng cho SSH tunnel khi migrate/dump).
# POSTGRES_PORT=5432

# Thư mục dữ liệu trên host (bind mount). Mặc định nằm dưới /var/lib/quanlysanxuat/.
# Local không có quyền ghi /var/lib thì trỏ sang thư mục khác, ví dụ ./data/postgres.
# PGDATA_DIR=/var/lib/quanlysanxuat/postgres
# REDIS_DATA_DIR=/var/lib/quanlysanxuat/redis
# UPLOADS_DIR=/var/lib/quanlysanxuat/uploads

# HOST_PORT=8003
